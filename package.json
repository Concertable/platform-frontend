{
  "name": "concertable-platform-frontend",
  "private": true,
  "description": "Publisher for the Concertable frontend platform tiers.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build -w @concertable/shared",
    "lint": "check-fe-boundaries",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build -w @concertable/shared && npm run build -w @concertable/web && npm run build -w @concertable/mobile",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "dependency-cruiser": "^17.4.3",
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "overrides": {
    "react-native-css-interop": {
      "tailwindcss": "^3"
    },
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "^8.0.16",
    "shell-quote": "^1.8.4",
    "form-data": "^4.0.6",
    "hono": "^4.12.25",
    "undici": "^6.27.0",
    "tar": "^7.5.16",
    "@babel/core": "^7.29.6",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "js-yaml": "^4.2.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.0"
    },
    "@expo/cli": {
      "ws": "^8.21.0"
    },
    "@microsoft/signalr": {
      "ws": "^7.5.11"
    },
    "metro": {
      "ws": "^7.5.11"
    },
    "react-devtools-core": {
      "ws": "^7.5.11"
    },
    "@react-native/dev-middleware": {
      "ws": "^6.2.4"
    },
    "react-native": {
      "ws": "^6.2.4"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
